#!/bin/sh
# Adaptive connection-level spillover monitor for Campus Route.
# It owns sampling/state; campus-route remains the sole writer of iptables
# policy and serializes any resulting reconcile.

PATH=/usr/sbin:/usr/bin:/sbin:/bin
CONFIG=campus_route
STATE_DIR=/var/run/campus-route
STATE_FILE="$STATE_DIR/accel.state"
STATS_FILE="$STATE_DIR/accel.stats"
MAIN_STATE_FILE="$STATE_DIR/state"
SELECT_CHAIN=CAMPUS_ROUTE_ACCEL_SELECT
SELECTED_CHAIN=CAMPUS_ROUTE_ACCEL_SELECTED
DOWN_CHAIN=CAMPUS_ROUTE_ACCEL_DOWN
UP_CHAIN=CAMPUS_ROUTE_ACCEL_UP
LOCAL_CHAIN=CAMPUS_ROUTE_ACCEL_LOCAL
NEW_CHAIN=CAMPUS_ROUTE_ACCEL_NEW
MOVED_CHAIN=CAMPUS_ROUTE_ACCEL_MOVED
MARK_CAMPUS=4096
MARK_ACCEL=1073750016

mkdir -p "$STATE_DIR" 2>/dev/null
cfg() { uci -q get "$CONFIG.main.$1" 2>/dev/null; }
cfg_bool() { case "$(cfg "$1")" in 1|yes|true|on|enabled) printf '1' ;; *) printf '0' ;; esac; }
state_get() { [ -f "$STATE_FILE" ] && awk -F= -v k="$1" '$1==k {print substr($0,index($0,"=")+1); exit}' "$STATE_FILE" 2>/dev/null; }
stat_get() { [ -f "$STATS_FILE" ] && awk -F= -v k="$1" '$1==k {print substr($0,index($0,"=")+1); exit}' "$STATS_FILE" 2>/dev/null; }
main_state_get() { [ -f "$MAIN_STATE_FILE" ] && awk -F= -v k="$1" '$1==k {print substr($0,index($0,"=")+1); exit}' "$MAIN_STATE_FILE" 2>/dev/null; }
resolve_dev() {
	local logical="$1" dev json
	if command -v ubus >/dev/null 2>&1 && command -v jsonfilter >/dev/null 2>&1; then
		json="$(ubus -S call network.interface."$logical" status 2>/dev/null)"
		dev="$(printf '%s' "$json" | jsonfilter -e '@.l3_device' 2>/dev/null)"
		[ -n "$dev" ] || dev="$(printf '%s' "$json" | jsonfilter -e '@.device' 2>/dev/null)"
	fi
	[ -n "$dev" ] || dev="$logical"
	[ -e "/sys/class/net/$dev" ] && printf '%s\n' "$dev"
}
route_ok() { local dev="$1" af="${2:-4}"; [ -n "$dev" ] && ip -"$af" route show default dev "$dev" 2>/dev/null | grep -q .; }
resolve_usb_dev() {
	local primary fallback dev
	primary="$(cfg usb_iface_primary)"; [ -n "$primary" ] || primary=wanusb
	fallback="$(cfg usb_iface_fallback)"; [ -n "$fallback" ] || fallback=wwan
	for logical in "$primary" "$fallback"; do
		dev="$(resolve_dev "$logical")"
		[ -n "$dev" ] || continue
		if route_ok "$dev" 4 || route_ok "$dev" 6; then printf '%s\n' "$dev"; return 0; fi
		[ -n "$USB_DEV_CANDIDATE" ] || USB_DEV_CANDIDATE="$dev"
	done
	printf '%s\n' "$USB_DEV_CANDIDATE"
}
counter_bytes() { local cmd="$1" chain="$2"; [ -n "$cmd" ] || { printf '0\n'; return; }; "$cmd" -t mangle -L "$chain" -v -x -n 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9]+$/ {b+=$2} END {print b+0}'; }
counter_packets() { local cmd="$1" chain="$2"; [ -n "$cmd" ] || { printf '0\n'; return; }; "$cmd" -t mangle -L "$chain" -v -x -n 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9]+$/ {p+=$1} END {print p+0}'; }
last_rule_bytes() { local cmd="$1" chain="$2"; [ -n "$cmd" ] || { printf '0\n'; return; }; "$cmd" -t mangle -L "$chain" -v -x -n 2>/dev/null | awk 'NR>2 && $1 ~ /^[0-9]+$/ {b=$2; found=1} END {print found ? b+0 : 0}'; }
first_rule_packets() { local cmd="$1" chain="$2"; [ -n "$cmd" ] || { printf '0\n'; return; }; "$cmd" -t mangle -L "$chain" -v -x -n 2>/dev/null | awk 'NR==3 {print $1+0; found=1} END {if(!found) print 0}'; }
active_flows() {
	local f n
	for f in /proc/net/nf_conntrack /proc/net/ip_conntrack; do
		[ -r "$f" ] || continue
		n="$(awk -v mark="$MARK_CAMPUS" -v accel="$MARK_ACCEL" '/ESTABLISHED|ASSURED/ && (index($0,"mark=" mark) || index($0,"mark=" mark ",") || index($0,"mark=0x1000") || index($0,"mark=" accel) || index($0,"mark=" accel ",") || index($0,"mark=0x40002000")) {n++} END {print n+0}' "$f" 2>/dev/null)"
		printf '%s\n' "$n"; return
	done
	if command -v conntrack >/dev/null 2>&1; then conntrack -L 2>/dev/null | awk -v mark="$MARK_CAMPUS" -v accel="$MARK_ACCEL" '/ESTABLISHED|ASSURED/ && (index($0,"mark=" mark) || index($0,"mark=" mark ",") || index($0,"mark=0x1000") || index($0,"mark=" accel) || index($0,"mark=" accel ",") || index($0,"mark=0x40002000")) {n++} END {print n+0}'; return; fi
	printf '%s\n' 0
}
write_state() {
	local tmp="$STATE_FILE.tmp.$$"; {
		printf 'enabled=%s\nactive=%s\nshare_percent=%s\nstate=%s\nreason=%s\nhigh_seconds=%s\nlow_seconds=%s\nupdated=%s\n' \
			"$ACCEL_ENABLED" "$ACTIVE" "$SHARE" "$STATE" "$REASON" "$HIGH_SECONDS" "$LOW_SECONDS" \
			"$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date)"
	} > "$tmp" && mv -f "$tmp" "$STATE_FILE"
}
write_stats() {
	local tmp="$STATS_FILE.tmp.$$"; {
		printf 'sample_epoch=%s\ncampus_down_bytes=%s\ncampus_up_bytes=%s\nnew_counter=%s\n' "$NOW" "$DOWN" "$UP" "$NEW"
		printf 'campus_down_mbps=%s\ncampus_up_mbps=%s\nactive_flows=%s\nnew_flows_per_sec=%s\nmoved_flows=%s\nmoved_bytes=%s\nselected_counter=%s\nmoved_counter=%s\n' \
			"$DOWN_MBPS" "$UP_MBPS" "$FLOWS" "$NEW_RATE" "$MOVED_FLOWS" "$MOVED_BYTES" "$SELECTED" "$MOVED_COUNTER"
	} > "$tmp" && mv -f "$tmp" "$STATS_FILE"
}
reconcile_if_changed() {
	[ "$OLD_ACTIVE" = "$ACTIVE" ] && [ "$OLD_SHARE" = "$SHARE" ] && return 0
	# campus-route owns firewall mutation and its reconcile lock.  Invoke the
	# fixed command here so a share step is installed promptly, while concurrent
	# hotplug/firewall events remain serialized by the same lock.
	[ -x /usr/bin/campus-route ] && /usr/bin/campus-route reconcile >/dev/null 2>&1 || true
}
sample() {
	ACCEL_ENABLED="$(cfg_bool accel_enabled)"
	CAMPUS_IFACE="$(cfg campus_iface)"; [ -n "$CAMPUS_IFACE" ] || CAMPUS_IFACE=wan
	USB_IFACE="$(cfg usb_iface_primary)"; [ -n "$USB_IFACE" ] || USB_IFACE=wanusb
	CAMPUS_DEV="$(resolve_dev "$CAMPUS_IFACE")"; USB_DEV_CANDIDATE=""; USB_DEV="$(resolve_usb_dev)"
	IPT4="$(command -v iptables-legacy 2>/dev/null)"; IPT6="$(command -v ip6tables-legacy 2>/dev/null)"
	ACTIVE="$(state_get active)"; case "$ACTIVE" in 1) ;; *) ACTIVE=0 ;; esac
	SHARE="$(state_get share_percent)"; case "$SHARE" in ''|*[!0-9]*) SHARE=0 ;; esac
	HIGH_SECONDS="$(state_get high_seconds)"; case "$HIGH_SECONDS" in ''|*[!0-9]*) HIGH_SECONDS=0 ;; esac
	LOW_SECONDS="$(state_get low_seconds)"; case "$LOW_SECONDS" in ''|*[!0-9]*) LOW_SECONDS=0 ;; esac
	# Capture the previous decision before any early disable/degraded return so
	# a transition to zero triggers exactly one policy reconcile, while an
	# already-disabled sampler does not rebuild the firewall every five seconds.
	OLD_ACTIVE="$ACTIVE"; OLD_SHARE="$SHARE"
	MAX_SHARE="$(cfg accel_max_usb_share_percent)"; case "$MAX_SHARE" in ''|*[!0-9]*) MAX_SHARE=50 ;; esac
	STEP="$(cfg accel_step_percent)"; case "$STEP" in ''|*[!0-9]*) STEP=10 ;; esac
	CAP="$(cfg bandwidth_cap_mbps)"; [ -n "$CAP" ] || CAP="$(cfg accel_bandwidth_cap_mbps)"; case "$CAP" in ''|*[!0-9]*) CAP=500 ;; esac
	TRIGGER="$(cfg accel_trigger_percent)"; case "$TRIGGER" in ''|*[!0-9]*) TRIGGER=85 ;; esac
	RELEASE="$(cfg accel_release_percent)"; case "$RELEASE" in ''|*[!0-9]*) RELEASE=75 ;; esac
	MIN_FLOWS="$(cfg accel_min_active_flows)"; case "$MIN_FLOWS" in ''|*[!0-9]*) MIN_FLOWS=8 ;; esac
	MIN_NEW="$(cfg accel_min_new_flows_per_sec)"; case "$MIN_NEW" in ''|*[!0-9]*) MIN_NEW=2 ;; esac
	TRIGGER_SECONDS="$(cfg accel_trigger_seconds)"; case "$TRIGGER_SECONDS" in ''|*[!0-9]*) TRIGGER_SECONDS=10 ;; esac
	RELEASE_SECONDS="$(cfg accel_release_seconds)"; case "$RELEASE_SECONDS" in ''|*[!0-9]*) RELEASE_SECONDS=30 ;; esac
	if [ "$ACCEL_ENABLED" -ne 1 ]; then ACTIVE=0; SHARE=0; STATE=disabled; REASON=disabled; HIGH_SECONDS=0; LOW_SECONDS=0; NOW="$(date +%s)"; DOWN=0; UP=0; NEW=0; DOWN_MBPS=0; UP_MBPS=0; FLOWS=0; NEW_RATE=0; MOVED_FLOWS=0; MOVED_BYTES=0; MOVED_COUNTER=0; SELECTED=0; write_state; write_stats; reconcile_if_changed; return 0; fi
	if [ -z "$IPT4" ] || ! "$IPT4" -t mangle -S "$NEW_CHAIN" >/dev/null 2>&1 || ! "$IPT4" -t mangle -S "$DOWN_CHAIN" >/dev/null 2>&1 || ! "$IPT4" -m statistic --help >/dev/null 2>&1 || { [ ! -r /proc/net/nf_conntrack ] && [ ! -r /proc/net/ip_conntrack ] && ! command -v conntrack >/dev/null 2>&1; }; then
		ACTIVE=0; SHARE=0; STATE=degraded; REASON=backend_unavailable; HIGH_SECONDS=0; LOW_SECONDS=0; NOW="$(date +%s)"; DOWN=0; UP=0; NEW=0; DOWN_MBPS=0; UP_MBPS=0; FLOWS=0; NEW_RATE=0; MOVED_FLOWS=0; MOVED_BYTES=0; MOVED_COUNTER=0; SELECTED=0; write_state; write_stats; reconcile_if_changed; return 0
	fi
	SCOPE="$(cfg scope)"; [ -n "$SCOPE" ] || SCOPE=router_and_lan
	if [ "$SCOPE" != router_and_lan ]; then ACTIVE=0; SHARE=0; STATE=degraded; REASON=scope_unsupported; HIGH_SECONDS=0; LOW_SECONDS=0; NOW="$(date +%s)"; DOWN=0; UP=0; NEW=0; DOWN_MBPS=0; UP_MBPS=0; FLOWS=0; NEW_RATE=0; MOVED_FLOWS="$(stat_get moved_flows)"; MOVED_BYTES="$(stat_get moved_bytes)"; MOVED_COUNTER=0; SELECTED=0; case "$MOVED_FLOWS" in ''|*[!0-9]*) MOVED_FLOWS=0 ;; esac; case "$MOVED_BYTES" in ''|*[!0-9]*) MOVED_BYTES=0 ;; esac; write_state; write_stats; reconcile_if_changed; return 0; fi
	CAMPUS_ONLINE="$(main_state_get campus_online)"; case "$CAMPUS_ONLINE" in 0|1) ;; *) CAMPUS_ONLINE=0; route_ok "$CAMPUS_DEV" && CAMPUS_ONLINE=1 ;; esac
	USB_ONLINE4=0; USB_ONLINE6=0; route_ok "$USB_DEV" 4 && USB_ONLINE4=1; route_ok "$USB_DEV" 6 && USB_ONLINE6=1
	USB_ONLINE=0; [ "$USB_ONLINE4" -eq 1 ] || [ "$USB_ONLINE6" -eq 1 ] && USB_ONLINE=1
	if [ "$CAMPUS_ONLINE" -ne 1 ] || [ "$USB_ONLINE" -ne 1 ]; then ACTIVE=0; SHARE=0; STATE=degraded; REASON=link_unavailable; HIGH_SECONDS=0; LOW_SECONDS=0; NOW="$(date +%s)"; DOWN=0; UP=0; NEW=0; DOWN_MBPS=0; UP_MBPS=0; FLOWS=0; NEW_RATE=0; MOVED_FLOWS="$(stat_get moved_flows)"; MOVED_BYTES="$(stat_get moved_bytes)"; MOVED_COUNTER=0; SELECTED=0; case "$MOVED_FLOWS" in ''|*[!0-9]*) MOVED_FLOWS=0 ;; esac; case "$MOVED_BYTES" in ''|*[!0-9]*) MOVED_BYTES=0 ;; esac; write_state; write_stats; reconcile_if_changed; return 0; fi
	NOW="$(date +%s 2>/dev/null || printf '0')"; PREV="$(stat_get sample_epoch)"; PREV_DOWN="$(stat_get campus_down_bytes)"; PREV_UP="$(stat_get campus_up_bytes)"; PREV_NEW="$(stat_get new_counter)"
	DOWN="$(last_rule_bytes "$IPT4" "$DOWN_CHAIN")"; UP="$(last_rule_bytes "$IPT4" "$UP_CHAIN")"; LOCAL_UP="$(last_rule_bytes "$IPT4" "$LOCAL_CHAIN")"; UP=$((UP + LOCAL_UP)); NEW="$(counter_packets "$IPT4" "$NEW_CHAIN")"; SELECTED="$(first_rule_packets "$IPT4" "$SELECTED_CHAIN")"; MOVED_COUNTER="$(counter_bytes "$IPT4" "$MOVED_CHAIN")"
	IPV6="$(cfg_bool ipv6)"; [ "$IPV6" = 1 ] 2>/dev/null && { DOWN=$((DOWN + $(last_rule_bytes "$IPT6" "$DOWN_CHAIN"))); UP=$((UP + $(last_rule_bytes "$IPT6" "$UP_CHAIN"))); UP=$((UP + $(last_rule_bytes "$IPT6" "$LOCAL_CHAIN"))); NEW=$((NEW + $(counter_packets "$IPT6" "$NEW_CHAIN"))); SELECTED=$((SELECTED + $(first_rule_packets "$IPT6" "$SELECTED_CHAIN"))); MOVED_COUNTER=$((MOVED_COUNTER + $(counter_bytes "$IPT6" "$MOVED_CHAIN"))); }
	case "$PREV" in ''|*[!0-9]*) PREV="$NOW" ;; esac; case "$PREV_DOWN" in ''|*[!0-9]*) PREV_DOWN="$DOWN" ;; esac; case "$PREV_UP" in ''|*[!0-9]*) PREV_UP="$UP" ;; esac; case "$PREV_NEW" in ''|*[!0-9]*) PREV_NEW="$NEW" ;; esac
	ELAPSED=$((NOW - PREV)); [ "$ELAPSED" -gt 0 ] || ELAPSED=1; [ "$DOWN" -ge "$PREV_DOWN" ] 2>/dev/null || PREV_DOWN="$DOWN"; [ "$UP" -ge "$PREV_UP" ] 2>/dev/null || PREV_UP="$UP"; [ "$NEW" -ge "$PREV_NEW" ] 2>/dev/null || PREV_NEW="$NEW"
	# Divide before multiplying to remain safe on 32-bit OpenWrt shells.
	DOWN_MBPS=$(( (DOWN - PREV_DOWN) / ELAPSED / 125000 )); UP_MBPS=$(( (UP - PREV_UP) / ELAPSED / 125000 )); NEW_RATE=$(( (NEW - PREV_NEW) / ELAPSED )); FLOWS="$(active_flows)"
	PREV_SELECTED="$(stat_get selected_counter)"; PREV_MOVED_COUNTER="$(stat_get moved_counter)"; MOVED_FLOWS="$(stat_get moved_flows)"; MOVED_BYTES="$(stat_get moved_bytes)"
	case "$PREV_SELECTED" in ''|*[!0-9]*) PREV_SELECTED="$SELECTED" ;; esac; case "$PREV_MOVED_COUNTER" in ''|*[!0-9]*) PREV_MOVED_COUNTER="$MOVED_COUNTER" ;; esac; case "$MOVED_FLOWS" in ''|*[!0-9]*) MOVED_FLOWS=0 ;; esac; case "$MOVED_BYTES" in ''|*[!0-9]*) MOVED_BYTES=0 ;; esac
	[ "$SELECTED" -ge "$PREV_SELECTED" ] 2>/dev/null && MOVED_FLOWS=$((MOVED_FLOWS + SELECTED - PREV_SELECTED)); [ "$MOVED_COUNTER" -ge "$PREV_MOVED_COUNTER" ] 2>/dev/null && MOVED_BYTES=$((MOVED_BYTES + MOVED_COUNTER - PREV_MOVED_COUNTER))
	[ "$MOVED_COUNTER" -lt "$PREV_MOVED_COUNTER" ] 2>/dev/null && : # firewall rebuild reset; keep the cumulative total
	HIGH=0; LOW=0; [ $((DOWN_MBPS * 100 / CAP)) -ge "$TRIGGER" ] 2>/dev/null && HIGH=1; [ $((UP_MBPS * 100 / CAP)) -ge "$TRIGGER" ] 2>/dev/null && HIGH=1; [ $((DOWN_MBPS * 100 / CAP)) -le "$RELEASE" ] 2>/dev/null && [ $((UP_MBPS * 100 / CAP)) -le "$RELEASE" ] 2>/dev/null && LOW=1; [ "$FLOWS" -ge "$MIN_FLOWS" ] 2>/dev/null || HIGH=0; [ "$NEW_RATE" -ge "$MIN_NEW" ] 2>/dev/null || HIGH=0
	[ "$HIGH" -eq 1 ] && { HIGH_SECONDS=$((HIGH_SECONDS + ELAPSED)); LOW_SECONDS=0; } || HIGH_SECONDS=0; [ "$LOW" -eq 1 ] && LOW_SECONDS=$((LOW_SECONDS + ELAPSED)) || LOW_SECONDS=0
	OLD_SHARE="$SHARE"; OLD_ACTIVE="$ACTIVE"
	if [ "$HIGH" -eq 1 ] && [ "$HIGH_SECONDS" -ge "$TRIGGER_SECONDS" ]; then ACTIVE=1; SHARE=$((SHARE + STEP)); [ "$SHARE" -gt "$MAX_SHARE" ] && SHARE="$MAX_SHARE"; STATE=accelerating; REASON=high_load; HIGH_SECONDS=0
	elif [ "$ACTIVE" -eq 1 ] && [ "$LOW" -eq 1 ] && [ "$LOW_SECONDS" -ge "$RELEASE_SECONDS" ]; then SHARE=$((SHARE - STEP)); [ "$SHARE" -lt 0 ] && SHARE=0; [ "$SHARE" -eq 0 ] && ACTIVE=0; STATE=monitoring; REASON=load_released; LOW_SECONDS=0
	else [ "$ACTIVE" -eq 1 ] && STATE=accelerating || STATE=monitoring; REASON=threshold_not_met; fi
	write_state; write_stats; reconcile_if_changed
}
daemon_loop() { trap 'exit 0' TERM INT; while :; do sample; INTERVAL="$(cfg accel_sample_interval)"; case "$INTERVAL" in ''|*[!0-9]*) INTERVAL=5 ;; esac; [ "$INTERVAL" -ge 2 ] 2>/dev/null || INTERVAL=2; sleep "$INTERVAL"; done; }
case "$1" in sample|--sample|'') sample ;; daemon|--daemon) daemon_loop ;; status|--status) [ -f "$STATE_FILE" ] && cat "$STATE_FILE"; [ -f "$STATS_FILE" ] && cat "$STATS_FILE" ;; *) printf '%s\n' "Usage: $0 sample|daemon|status" >&2; exit 2 ;; esac
