config campus_route 'main'
	option enabled '0'
	option campus_iface 'wan'
	option usb_iface_primary 'wanusb'
	option usb_iface_fallback 'wwan'
	option usb_missing_action 'reject'
	option usb_missing_fallback '0'
	option campus_failover '1'
	option campus_healthcheck '1'
	list campus_probe_host '223.5.5.5'
	list campus_probe_host '180.76.76.76'
	# Optional literal Dr.COM portal address; empty means read drcom.main.portal_host.
	# list campus_portal_host 'PORTAL_HOST'
	option campus_probe_timeout '2'
	option campus_fail_threshold '1'
	option campus_recover_threshold '2'
	option plugin_compat '0'
	option ipv6 '1'
	option accel_enabled '0'
	option bandwidth_cap_mbps '500'
	# Legacy alias retained for upgrades from the first public accelerator build.
	option accel_bandwidth_cap_mbps '500'
	option accel_trigger_percent '85'
	option accel_release_percent '75'
	option accel_min_active_flows '8'
	option accel_min_new_flows_per_sec '2'
	option accel_trigger_seconds '10'
	option accel_release_seconds '30'
	option accel_max_usb_share_percent '50'
	option accel_step_percent '10'
	option accel_sample_interval '5'
	option unknown_policy 'usb'
	option domestic_precedence '1'
	list encrypted_tcp '443'
	list encrypted_tcp '853'
	list encrypted_tcp '8443'
	list encrypted_udp '443'
	list encrypted_udp '784'
	list encrypted_udp '8853'
	option rule_refresh 'weekly'
	option reconcile_interval '30'
	option scope 'router_and_lan'
	option campus_table '0'
	option usb_table '0'
	option block_table '0'
	option mark_mask '0xf000'
	option cn4_file '/etc/campus-route/rules/cn4.txt'
	option cn6_file '/etc/campus-route/rules/cn6.txt'
	option geosite_file '/etc/campus-route/rules/geosite-cn.txt'
	option cn4_source 'https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china.txt'
	option cn6_source 'https://raw.githubusercontent.com/gaoyifan/china-operator-ip/ip-lists/china6.txt'
	option geosite_source ''
	option update_timeout '30'
	option insecure_fetch '0'
	option cn4_sha256 ''
	option cn6_sha256 ''
	option geosite_sha256 ''
	option cn4_version 'unversioned'
	option cn6_version 'unversioned'
	option geosite_version 'unversioned'
	option rules_license ''
	option maxelem '200000'
