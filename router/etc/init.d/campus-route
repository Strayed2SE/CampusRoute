#!/bin/sh /etc/rc.common
# Campus Route procd service

START=95
STOP=10
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/campus-route daemon
	procd_set_param respawn 3600 5 5
	procd_set_param stdout 0
	procd_set_param stderr 0
	procd_close_instance
}

stop_service() {
	/usr/bin/campus-route stop >/dev/null 2>&1
}

reload_service() {
	/usr/bin/campus-route reconcile >/dev/null 2>&1
}

service_triggers() {
	procd_add_reload_trigger campus_route network firewall
}